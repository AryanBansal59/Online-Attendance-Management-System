<%- include('partials/header', { title: 'View Attendance - AttendTrack' }) %>

<style>
  /* View Attendance specific styles */
  .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; padding: 16px 20px; background: var(--surface); border: 1px solid var(--border2); border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
  .header-left { display: flex; align-items: center; gap: 10px; }
  .header-icon { width: 38px; height: 38px; background: linear-gradient(135deg, var(--cyan), var(--violet)); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 18px; box-shadow: 0 0 18px rgba(6,182,212,0.25); }
  .header-title { font-size: 16px; font-weight: 700; color: var(--text); }
  .header-sub { font-size: 11px; color: var(--text-muted); margin-top: 1px; }
  .user-card { text-align: right; font-size: 12px; color: var(--text-muted); }
  .user-card strong { color: var(--text); display: block; margin-bottom: 6px; font-size: 13px; }
  .logout-btn { padding: 6px 14px; background: rgba(244,63,94,0.1); border: 1px solid rgba(244,63,94,0.2); color: #fda4af; border-radius: 7px; cursor: pointer; font-size: 12px; font-weight: 600; transition: all 0.2s; width: auto; }
  .alert { display: none; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 20px; }
  .alert.show { display: flex; }
  .alert.error { background: rgba(244,63,94,0.08); border: 1px solid rgba(244,63,94,0.2); color: #fda4af; }
  .search-row { display: flex; gap: 12px; margin-bottom: 10px; }
  .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 10px; }
  .stat-card { background: var(--surface2); border: 1px solid var(--border); border-radius: 12px; padding: 18px; text-align: center; position: relative; overflow: hidden; }
  .stat-card.full { grid-column: 1 / -1; }
  .stat-value { font-size: 30px; font-weight: 800; color: var(--text); font-family: 'JetBrains Mono', monospace; }
  .progress-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-top: 10px; }
  .progress-fill { height: 100%; background: linear-gradient(90deg, var(--cyan), var(--violet)); border-radius: 10px; transition: width 1s cubic-bezier(0.16,1,0.3,1); }
  .record { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .status-badge { padding: 4px 12px; border-radius: 100px; font-size: 12px; font-weight: 700; text-transform: uppercase; border: 1px solid; }
  .status-present { background: rgba(16,185,129,0.1); color: #6ee7b7; border-color: rgba(16,185,129,0.25); }
  .status-absent { background: rgba(244,63,94,0.08); color: #fda4af; border-color: rgba(244,63,94,0.2); }
  .empty-state { text-align: center; padding: 40px 20px; }
  .back-links { display: flex; gap: 20px; justify-content: center; margin-top: 20px; }
  .back-links a { font-size: 13px; color: var(--text-dim); text-decoration: none; font-family: 'JetBrains Mono', monospace; }
</style>

<div class="header">
  <div class="header-left">
    <div class="header-icon">📊</div>
    <div>
      <div class="header-title">View Attendance</div>
      <div class="header-sub">Check records & statistics</div>
    </div>
  </div>
  <div class="user-card" id="userInfo"></div>
</div>

<div class="alert" id="message"></div>

<div id="authCheck" style="display:none;" class="auth-check">
  <p>⚠️ Please login first</p>
  <a href="/api/auth/signin">Go to Sign In →</a>
</div>

<div id="content" style="display:none;">
  <div class="card">
    <div class="card-title">🔍 Search Attendance</div>
    <form id="searchForm" onsubmit="handleSearch(event)">
      <div class="search-row">
        <div class="input-wrap">
          <span class="input-icon">🆔</span>
          <input type="text" id="studentId" placeholder="Enter student ID">
        </div>
        <button type="submit" class="btn" id="searchBtn" style="width:auto;">
          <div class="btn-spinner" id="searchSpinner"></div>
          <span id="searchText">Search</span>
        </button>
      </div>
    </form>
  </div>

  <div id="statsContainer" style="display:none; margin-top: 32px;" class="card">
    <div class="card-title">📈 Attendance Overview</div>
    <div class="stats-grid">
      <div class="stat-card full">
        <div class="stat-label">Attendance Percentage</div>
        <div class="stat-value" id="percentage">0%</div>
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill" style="width:0%"></div>
        </div>
      </div>
      <div class="stat-card"><div class="stat-label">Total Days</div><div class="stat-value" id="totalDays">0</div></div>
      <div class="stat-card"><div class="stat-label">Present</div><div class="stat-value" id="presentDays">0</div></div>
    </div>
  </div>

  <div id="recordsCard" style="display:none; margin-top: 32px;" class="card">
    <div class="card-title">📋 Attendance Records</div>
    <div id="recordsList"></div>
  </div>

  <div id="emptyState" class="card" style="margin-top: 32px;">
    <div class="empty-state">
      <p>Enter a student ID above to view attendance records</p>
    </div>
  </div>
</div>

<div class="back-links" id="backLink">
  <a href="/dashboard">← Dashboard</a>
  <a href="/">← Home</a>
</div>

<script>
  const API_URL = '/api';
  const user = JSON.parse(localStorage.getItem('user'));
  if (!user) {
    document.getElementById('authCheck').style.display = 'block';
  } else {
    document.getElementById('content').style.display = 'block';
    document.getElementById('userInfo').innerHTML = `
      <strong>${user.name}</strong>
      <span>${user.email}</span><br>
      <button class="logout-btn" onclick="logout()" style="margin-top:6px;">Sign Out</button>
    `;
    if (user.role === 'student' && user.id) {
      document.getElementById('studentId').value = user.id;
      document.getElementById('studentId').disabled = true;
      searchAttendance();
    }
  }

  function handleSearch(e) {
    if (e) e.preventDefault();
    searchAttendance();
  }

  async function searchAttendance() {
    const studentId = document.getElementById('studentId').value;
    if (!studentId) return;
    const btn = document.getElementById('searchBtn');
    btn.disabled = true;
    try {
      const response = await fetch(`${API_URL}/attendance/my-attendance/${studentId}`);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error);
      document.getElementById('statsContainer').style.display = 'block';
      document.getElementById('emptyState').style.display = 'none';
      document.getElementById('percentage').textContent = data.attendancePercentage + '%';
      document.getElementById('totalDays').textContent = data.totalDays;
      document.getElementById('presentDays').textContent = data.presentDays;
      setTimeout(() => document.getElementById('progressFill').style.width = data.attendancePercentage + '%', 100);
      if (data.records.length > 0) {
        document.getElementById('recordsCard').style.display = 'block';
        document.getElementById('recordsList').innerHTML = data.records.map(r => `
          <div class="record">
            <div>
              <div style="display:flex;align-items:center;gap:10px;">
                <span style="font-weight:600;">${r.date}</span>
                <span style="font-size:10px;font-weight:700;color:var(--cyan);background:rgba(6,182,212,0.1);padding:1px 6px;border-radius:4px;border:1px solid rgba(6,182,212,0.2);">${r.subject || 'General'}</span>
              </div>
              <div style="font-size:11px;color:var(--text-muted);">Marked: ${new Date(r.markedAt).toLocaleString()}</div>
            </div>
            <span class="status-badge status-${r.status}">${r.status}</span>
          </div>
        `).join('');
      } else {
        document.getElementById('recordsCard').style.display = 'none';
      }
    } catch (error) {
      console.error(error);
    } finally {
      btn.disabled = false;
    }
  }

  function logout() {
    localStorage.removeItem('token');
    localStorage.removeItem('user');
    window.location.href = '/api/auth/signin';
  }
</script>

<%- include('partials/footer') %>
