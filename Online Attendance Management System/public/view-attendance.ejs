<!DOCTYPE html>
<html lang="en">
<head>
  <%# Meta Tags %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="shortcut icon" href="/favicon.svg">
  <title>View Attendance - Attendance Management System</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0d0d14;
      --surface: #1e1c2a;
      --surface2: #272535;
      --border: rgba(255,255,255,0.07);
      --border2: rgba(255,255,255,0.12);
      --text: #eeeaf8;
      --text-muted: #7c7a94;
      --text-dim: #4a4864;
      --violet: #7c3aed;
      --violet-light: #8b5cf6;
      --cyan: #06b6d4;
      --emerald: #10b981;
      --rose: #f43f5e;
      --amber: #f59e0b;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Outfit', sans-serif;
      background: var(--ink);
      min-height: 100vh;
      padding: 24px;
      position: relative;
    }

    .bg { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
    .bg-blob { position: absolute; border-radius: 50%; filter: blur(110px); opacity: 0.09; }
    .bg-blob-1 { width: 600px; height: 600px; background: var(--cyan); top: -200px; right: -150px; animation: blobFloat 12s ease-in-out infinite; }
    .bg-blob-2 { width: 500px; height: 500px; background: var(--violet); bottom: -100px; left: -100px; animation: blobFloat 10s ease-in-out infinite reverse; }

    @keyframes blobFloat {
      0%,100% { transform: translate(0,0); }
      50% { transform: translate(25px,-25px); }
    }

    body::before {
      content: ''; position: fixed; inset: 0;
      background-image: linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
      background-size: 48px 48px; pointer-events: none; z-index: 0;
    }

    .page { position: relative; z-index: 1; max-width: 760px; margin: 0 auto; animation: pageIn 0.6s cubic-bezier(0.16,1,0.3,1) both; }

    @keyframes pageIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    .header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 24px; padding: 16px 20px;
      background: var(--surface); border: 1px solid var(--border2);
      border-radius: 16px; box-shadow: 0 8px 24px rgba(0,0,0,0.3);
    }
    .header-left { display: flex; align-items: center; gap: 10px; }

    
    .brand-inline {
      display: flex; align-items: center; gap: 8px;
      padding-right: 12px; margin-right: 2px;
      border-right: 1px solid var(--border2);
    }
    .brand-inline-logo {
      width: 26px; height: 26px;
      background: linear-gradient(135deg, var(--violet), var(--cyan));
      border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px;
      box-shadow: 0 0 10px rgba(124,58,237,0.3);
    }
    .brand-inline-name {
      font-size: 13px; font-weight: 800; color: var(--text); letter-spacing: -0.3px;
    }
    .brand-inline-name span {
      background: linear-gradient(90deg, var(--violet-light), var(--cyan));
      -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    }

    .header-icon {
      width: 38px; height: 38px;
      background: linear-gradient(135deg, var(--cyan), var(--violet));
      border-radius: 10px; display: flex; align-items: center; justify-content: center;
      font-size: 18px; box-shadow: 0 0 18px rgba(6,182,212,0.25);
    }
    .header-title { font-size: 16px; font-weight: 700; color: var(--text); }
    .header-sub { font-size: 11px; color: var(--text-muted); margin-top: 1px; }

    .user-card { text-align: right; font-size: 12px; color: var(--text-muted); }
    .user-card strong { color: var(--text); display: block; margin-bottom: 6px; font-size: 13px; }

    .logout-btn {
      padding: 6px 14px; background: rgba(244,63,94,0.1);
      border: 1px solid rgba(244,63,94,0.2); color: #fda4af;
      border-radius: 7px; cursor: pointer; font-size: 12px; font-weight: 600;
      font-family: 'Outfit', sans-serif; transition: all 0.2s; width: auto;
    }
    .logout-btn:hover { background: rgba(244,63,94,0.18); transform: none; box-shadow: none; }

    .auth-check { text-align: center; padding: 50px 20px; background: var(--surface); border: 1px solid var(--border2); border-radius: 16px; }
    .auth-check p { font-size: 15px; color: #fda4af; margin-bottom: 10px; }
    .auth-check a { color: #a78bfa; text-decoration: none; font-weight: 600; }

    .alert { display: none; align-items: center; gap: 10px; padding: 12px 16px; border-radius: 10px; font-size: 13px; margin-bottom: 20px; }
    .alert.show { display: flex; }
    .alert.error { background: rgba(244,63,94,0.08); border: 1px solid rgba(244,63,94,0.2); color: #fda4af; }

    .card {
      background: var(--surface); border: 1px solid var(--border2);
      border-radius: 16px; padding: 24px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.3);
      margin-bottom: 16px;
    }

    .card-title { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 18px; display: flex; align-items: center; gap: 8px; }

    .search-row { display: flex; gap: 10px; }

    .input-wrap { position: relative; flex: 1; }
    .input-wrap input {
      width: 100%; padding: 11px 14px 11px 40px;
      background: var(--surface2); border: 1.5px solid var(--border);
      border-radius: 10px; font-size: 14px; color: var(--text);
      font-family: 'Outfit', sans-serif; outline: none; transition: all 0.22s;
    }
    .input-wrap input::placeholder { color: var(--text-dim); }
    .input-wrap input:focus { border-color: var(--cyan); background: #1c1e2e; box-shadow: 0 0 0 3px rgba(6,182,212,0.12); }
    .input-wrap input:disabled { opacity: 0.6; cursor: not-allowed; }

    .input-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 15px; pointer-events: none; opacity: 0.5; }

    .btn-search {
      padding: 11px 20px;
      background: linear-gradient(135deg, var(--cyan), var(--violet));
      color: white; border: none; border-radius: 10px;
      font-size: 14px; font-weight: 600; font-family: 'Outfit', sans-serif;
      cursor: pointer; transition: all 0.25s; white-space: nowrap;
      box-shadow: 0 4px 14px rgba(6,182,212,0.2);
      display: flex; align-items: center; gap: 6px; width: auto;
    }
    .btn-search:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(6,182,212,0.3); }
    .btn-search:disabled { opacity: 0.65; cursor: not-allowed; transform: none; }

    .btn-spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.65s linear infinite; display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn-search.loading .btn-spinner { display: block; }

    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .stat-card {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px; text-align: center;
      position: relative; overflow: hidden;
    }
    .stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--cyan), var(--violet)); }
    .stat-card.full { grid-column: 1 / -1; }
    .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 8px; }
    .stat-value { font-size: 30px; font-weight: 800; color: var(--text); font-family: 'JetBrains Mono', monospace; }

    .progress-bar { width: 100%; height: 6px; background: rgba(255,255,255,0.08); border-radius: 10px; overflow: hidden; margin-top: 12px; }
    .progress-fill { height: 100%; background: linear-gradient(90deg, var(--cyan), var(--violet)); border-radius: 10px; transition: width 1s cubic-bezier(0.16,1,0.3,1); }

    .records { display: grid; gap: 8px; }

    .record {
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; transition: all 0.18s;
    }
    .record:hover { border-color: var(--border2); background: #2a283a; transform: translateX(4px); }

    .record-info {}
    .record-date { font-size: 14px; font-weight: 600; color: var(--text); font-family: 'JetBrains Mono', monospace; }
    .record-time { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

    .status-badge {
      padding: 4px 12px; border-radius: 100px;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px;
    }
    .status-present { background: rgba(16,185,129,0.12); color: #6ee7b7; border: 1px solid rgba(16,185,129,0.22); }
    .status-absent { background: rgba(244,63,94,0.1); color: #fda4af; border: 1px solid rgba(244,63,94,0.2); }
    .status-late { background: rgba(245,158,11,0.1); color: #fcd34d; border: 1px solid rgba(245,158,11,0.2); }

    .empty-state {
      text-align: center; padding: 40px 20px;
      color: var(--text-muted); font-size: 14px;
    }
    .empty-state .empty-icon { font-size: 36px; margin-bottom: 12px; opacity: 0.5; }

    .back-links { display: flex; gap: 20px; justify-content: center; margin-top: 18px; }
    .back-links a { font-size: 13px; color: var(--text-dim); text-decoration: none; font-family: 'JetBrains Mono', monospace; transition: color 0.2s; }
    .back-links a:hover { color: var(--text-muted); }

    
    .site-footer {
      margin-top: 28px;
      padding-top: 18px;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .footer-brand { display: flex; align-items: center; gap: 7px; }
    .footer-brand-logo { width: 20px; height: 20px; background: linear-gradient(135deg, var(--violet), var(--cyan)); border-radius: 5px; display: flex; align-items: center; justify-content: center; font-size: 10px; }
    .footer-brand-name { font-size: 13px; font-weight: 700; color: var(--text-muted); }
    .footer-links { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
    .footer-links a { font-size: 12px; color: var(--text-dim); text-decoration: none; font-family: 'JetBrains Mono', monospace; transition: color 0.2s; }
    .footer-links a:hover { color: var(--text-muted); }
    .footer-copy { font-size: 11px; color: var(--text-dim); font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body>
  <div class="bg">
    <div class="bg-blob bg-blob-1"></div>
    <div class="bg-blob bg-blob-2"></div>
  </div>

  <div class="page">
    <div class="header">
      <div class="header-left">
        
        <div class="brand-inline">
          <div class="brand-inline-logo">📡</div>
          <div class="brand-inline-name">Attend<span>Track</span></div>
        </div>
        <div class="header-icon">📊</div>
        <div>
          <div class="header-title">View Attendance</div>
          <div class="header-sub">Check attendance records</div>
        </div>
      </div>
      <div class="user-card" id="userInfo"></div>
    </div>

    <div class="alert" id="message"></div>

    <div id="authCheck" style="display:none;" class="auth-check">
      <p>⚠️ Please login first</p>
      <a href="/api/auth/signin">Go to Sign In →</a>
    </div>

    <div id="content" style="display:none;">

      <div class="card">
        <div class="card-title">🔍 Search Attendance</div>
        <div class="search-row">
          <div class="input-wrap">
            <span class="input-icon">🆔</span>
            <input type="text" id="studentId" placeholder="Enter student ID to view their attendance">
          </div>
          <button class="btn-search" onclick="searchAttendance()" id="searchBtn">
            <div class="btn-spinner" id="searchSpinner"></div>
            <span id="searchText">Search</span>
          </button>
        </div>
      </div>

      <div id="statsContainer" style="display:none;" class="card">
        <div class="card-title">📈 Attendance Overview</div>
        <div class="stats-grid">
          <div class="stat-card full">
            <div class="stat-label">Attendance Percentage</div>
            <div class="stat-value" id="percentage">0%</div>
            <div class="progress-bar">
              <div class="progress-fill" id="progressFill" style="width:0%"></div>
            </div>
          </div>
          <div class="stat-card"><div class="stat-label">Total Days</div><div class="stat-value" id="totalDays">0</div></div>
          <div class="stat-card"><div class="stat-label">Present</div><div class="stat-value" id="presentDays">0</div></div>
          <div class="stat-card"><div class="stat-label">Absent</div><div class="stat-value" id="absentDays">0</div></div>
          <div class="stat-card"><div class="stat-label">Late</div><div class="stat-value" id="lateDays">0</div></div>
        </div>
      </div>

      <div id="recordsCard" style="display:none;" class="card">
        <div class="card-title">📋 Attendance Records</div>
        <div class="records" id="recordsList"></div>
      </div>

      <div id="emptyState" class="card">
        <div class="empty-state">
          <div class="empty-icon">📂</div>
          <p>Enter a student ID above to view attendance records</p>
        </div>
      </div>
    </div>

    <div class="back-links" id="backLink">
      <a href="/dashboard">← Dashboard</a>
      <a href="/">← Home</a>
    </div>

    
    <footer class="site-footer">
      <div class="footer-brand">
        <div class="footer-brand-logo">📡</div>
        <span class="footer-brand-name">AttendTrack</span>
      </div>
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/mark-attendance">Mark Attendance</a>
      </div>
      <div class="footer-copy">© 2025 AttendTrack · Attendance Management System</div>
    </footer>

  </div>

  <script>
    const API_URL = '/api';

    const user = JSON.parse(localStorage.getItem('user'));
    if (!user) {
      document.getElementById('authCheck').style.display = 'block';
    } else {
      document.getElementById('content').style.display = 'block';
      document.getElementById('userInfo').innerHTML = `
        <strong>${user.name}</strong>
        <span>${user.email}</span><br>
        <button class="logout-btn" onclick="logout()" style="margin-top:6px;">Sign Out</button>
      `;

      if (user.role === 'student' && user.id) {
        document.getElementById('studentId').value = user.id;
        document.getElementById('studentId').disabled = true;
        searchAttendance();
      }
    }

    function showMessage(msg, type) {
      const el = document.getElementById('message');
      el.textContent = '✕ ' + msg;
      el.className = 'alert show error';
    }

    async function searchAttendance() {
      const studentId = document.getElementById('studentId').value;
      if (!studentId) { showMessage('Please enter a student ID', 'error'); return; }

      const btn = document.getElementById('searchBtn');
      const spinner = document.getElementById('searchSpinner');
      const text = document.getElementById('searchText');
      btn.disabled = true; btn.classList.add('loading'); spinner.style.display = 'block'; text.textContent = 'Loading...';

      try {
        const response = await fetch(`${API_URL}/attendance/my-attendance/${studentId}`);
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to fetch attendance');

        document.getElementById('statsContainer').style.display = 'block';
        document.getElementById('emptyState').style.display = 'none';

        document.getElementById('percentage').textContent = data.attendancePercentage + '%';
        document.getElementById('totalDays').textContent = data.totalDays;
        document.getElementById('presentDays').textContent = data.presentDays;
        document.getElementById('absentDays').textContent = data.absentDays;
        document.getElementById('lateDays').textContent = data.lateDays;

        setTimeout(() => {
          document.getElementById('progressFill').style.width = data.attendancePercentage + '%';
        }, 100);

        if (data.records.length === 0) {
          document.getElementById('recordsCard').style.display = 'none';
          document.getElementById('emptyState').style.display = 'block';
          document.getElementById('emptyState').innerHTML = '<div class="empty-state"><div class="empty-icon">📭</div><p>No attendance records found yet.</p></div>';
        } else {
          document.getElementById('recordsCard').style.display = 'block';
          const list = document.getElementById('recordsList');
          list.innerHTML = data.records.map(record => `
            <div class="record">
              <div class="record-info">
                <div class="record-date">${record.date}</div>
                <div class="record-time">Marked: ${new Date(record.markedAt).toLocaleString()}</div>
              </div>
              <span class="status-badge status-${record.status}">${record.status}</span>
            </div>
          `).join('');
        }

      } catch (error) {
        showMessage(error.message, 'error');
        document.getElementById('statsContainer').style.display = 'none';
        document.getElementById('recordsCard').style.display = 'none';
        document.getElementById('emptyState').style.display = 'block';
      } finally {
        btn.disabled = false; btn.classList.remove('loading'); spinner.style.display = 'none'; text.textContent = 'Search';
      }
    }

    function logout() {
      localStorage.removeItem('token');
      localStorage.removeItem('user');
      window.location.href = '/api/auth/signin';
    }
  </script>
</body>
</html>
